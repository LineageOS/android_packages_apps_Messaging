<!-- RCS chat settings. With the master switch off every other row is disabled. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Master switch; off sends everything as SMS/MMS. -->
    <SwitchPreferenceCompat
        android:key="rcs_enabled"
        android:title="@string/rcs_enable_title"
        android:summary="@string/rcs_enable_summary"
        android:defaultValue="true"
        android:persistent="true" />

    <PreferenceCategory
        android:key="rcs_status_category"
        android:title="@string/rcs_settings_status_category">

        <Preference
            android:key="rcs_connection_status"
            android:title="@string/rcs_settings_connection_title"
            android:selectable="false"
            android:persistent="false" />

        <Preference
            android:key="rcs_provisioning_status"
            android:title="@string/rcs_settings_provisioning_title"
            android:selectable="false"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="rcs_features_category"
        android:title="@string/rcs_settings_features_category">

        <SwitchPreferenceCompat
            android:key="rcs_typing_indicators"
            android:title="@string/rcs_typing_title"
            android:summary="@string/rcs_typing_summary"
            android:defaultValue="true"
            android:persistent="true" />

        <!-- Global default for read receipts; conversations can override it. The key is
             ReadReceiptSettings.PREF_KEY_GLOBAL. -->
        <SwitchPreferenceCompat
            android:key="rcs_send_read_receipts"
            android:title="@string/rcs_read_receipts_title"
            android:summary="@string/rcs_read_receipts_summary"
            android:defaultValue="true"
            android:persistent="true" />

        <!-- Business messaging; a change is forwarded to the provider. -->
        <SwitchPreferenceCompat
            android:key="rcs_business_messaging"
            android:title="@string/rcs_business_messaging_title"
            android:summary="@string/rcs_business_messaging_summary"
            android:defaultValue="true"
            android:persistent="true" />

        <!-- Provider-layer encryption; not persisted here because the provider owns the state. -->
        <SwitchPreferenceCompat
            android:key="rcs_e2ee"
            android:title="@string/rcs_e2ee_title"
            android:summary="@string/rcs_e2ee_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="rcs_account_category"
        android:title="@string/rcs_settings_account_category">

        <Preference
            android:key="rcs_phone_number"
            android:title="@string/rcs_settings_phone_number_title"
            android:selectable="false"
            android:persistent="false" />

        <Preference
            android:key="rcs_verify_status"
            android:title="@string/rcs_settings_verify_title"
            android:selectable="false"
            android:persistent="false" />

        <Preference
            android:key="rcs_provider"
            android:title="@string/rcs_settings_provider_title"
            android:selectable="false"
            android:persistent="false" />

    </PreferenceCategory>

    <!-- Terms of service; summary and clickability follow the provider's terms state. -->
    <PreferenceCategory
        android:key="rcs_tos_category"
        android:title="@string/rcs_tos_settings_title">

        <Preference
            android:key="rcs_carrier_tos"
            android:title="@string/rcs_tos_settings_title"
            android:persistent="false" />

    </PreferenceCategory>

    <!-- Opens the provider's read-only diagnostic dump. -->
    <Preference
        android:key="rcs_advanced_status"
        android:title="@string/rcs_advanced_status_title"
        android:summary="@string/rcs_advanced_status_summary"
        android:persistent="false" />

</PreferenceScreen>
