<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/conversation_title_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="fill_horizontal"
    android:orientation="vertical"
    android:gravity="center_vertical" >

      <!-- Title row: optional RBM brand logo + title + optional verified badge.
           The logo and badge are GONE for every non-bot conversation, so with the
           title taking the remaining width (weight) the row is visually identical
           to the previous single-TextView header. Populated for an RBM bot 1:1 by
           ConversationFragment.updateBotBrandHeader(). -->
      <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" >

            <com.android.messaging.ui.AsyncImageView
                  android:id="@+id/conversation_brand_logo"
                  android:layout_width="@dimen/rbm_brand_logo_size"
                  android:layout_height="@dimen/rbm_brand_logo_size"
                  android:layout_marginEnd="8dp"
                  android:scaleType="fitCenter"
                  android:visibility="gone"
                  android:importantForAccessibility="no" />

            <TextView
                  android:id="@+id/conversation_title"
                  style="@style/ConversationActionBarTitleTextStyle"
                  android:layout_width="0dp"
                  android:layout_weight="1"
                  android:layout_height="wrap_content" />

            <ImageView
                  android:id="@+id/conversation_verified_badge"
                  android:layout_width="@dimen/rbm_verified_badge_size"
                  android:layout_height="@dimen/rbm_verified_badge_size"
                  android:layout_marginStart="4dp"
                  android:src="@drawable/ic_checkmark_circle_blue"
                  android:visibility="gone"
                  android:contentDescription="@string/rbm_verified_badge_content_description" />
      </LinearLayout>

      <!-- WAVE-A / A2.3: second line for GROUP conversations ("N people"). Hidden
           (GONE) for 1:1 conversations so the title stays vertically centered. -->
      <TextView
            android:id="@+id/conversation_subtitle"
            style="@style/ConversationActionBarSubtitleTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
</LinearLayout>
