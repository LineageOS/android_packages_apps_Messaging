<resources>
    <!-- RBM dark-mode overrides: chips sit on the (dark) conversation background,
         so use a lighter accent; the carousel card surface goes dark. -->
    <color name="rbm_chip_text">@android:color/system_accent1_200</color>
    <color name="rbm_chip_stroke">@android:color/system_accent1_300</color>
    <color name="rbm_carousel_card_bg">@android:color/system_neutral1_800</color>
    <color name="rbm_card_text_primary">#FFFFFFFF</color>
    <color name="rbm_card_text_secondary">#B3FFFFFF</color>

    <!-- RCS Advanced-status dark-mode overrides: lighter accent for
         titles, lighter green/gray for the connection value on a dark surface. -->
    <color name="rcs_status_label">@android:color/system_accent1_200</color>
    <color name="rcs_status_value_connected">#81C995</color>
    <color name="rcs_status_value_neutral">#9AA0A6</color>
</resources>
