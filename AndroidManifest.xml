                <action android:name="com.android.messaging.debug.SEND_GROUP" />
                <action android:name="com.android.messaging.debug.GROUP_INFO" />
            </intent-filter>
        </receiver>

        <!-- Debug-only native SipDelegate-ride trigger. Create the delegate
