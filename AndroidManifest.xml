            <intent-filter>
                <action android:name="com.android.messaging.debug.SHANNON_PULL_CONFIG" />
                <action android:name="com.android.messaging.debug.SIPDELEGATE_CREATE" />
                <action android:name="com.android.messaging.debug.SIPDELEGATE_STATUS" />
                <action android:name="com.android.messaging.debug.SIPDELEGATE_SEND" />
                <action android:name="com.android.messaging.debug.SIPDELEGATE_DESTROY" />
