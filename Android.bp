package {
    // See: http://go/android-license-faq
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

// Release proguard flags only; the eng-variant soong_config split is not carried.
java_defaults {
    name: "messaging_defaults",
    optimize: {
        proguard_flags_files: [
            "proguard.flags",
            "proguard-release.flags",
        ],
    },
}


filegroup {
    name: "messaging-srcs",
    srcs: ["src/**/*.java"],
}

// Shared with the self-test APK, which cannot reach a path above its own Android.bp.
filegroup {
    name: "messaging-mls-credential-srcs",
    srcs: ["src/com/android/messaging/rcs/e2ee/MlsCredential.java"],
}


android_app {
    name: "messaging",

    // Platform-signed to hold the signature|privileged BIND_RCS_PROVIDER permission and to
    // reach the telephony APIs of the native-IMS path.
    certificate: "platform",

    srcs: [":messaging-srcs"],

    defaults: ["messaging_defaults"],

    jni_libs: ["libmlsopenmlsbridge"],
    // Packaged inside the APK so an adb-installed update loads the same .so; see
    // docs/mls/overview.md.
    use_embedded_native_libs: true,
    static_libs: [
        "androidx.activity_activity",
        "androidx.annotation_annotation",
        "androidx.appcompat_appcompat",
        "androidx.collection_collection",
        "androidx.core_core",
        // EmojiCompat, to check that a user-picked reaction glyph is a real emoji.
        "androidx.emoji2_emoji2",
        "androidx.exifinterface_exifinterface",
        "androidx.fragment_fragment",
        "androidx.media_media",
        "androidx.palette_palette",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "androidx.viewpager_viewpager",
        "colorpicker",
        "com.android.vcard",
        "com.google.android.material_material",
        "guava",
        "libchips",
        "libphonenumber",
        "libphotoviewer",
        // The RCS provider contract; see aidl/.
        "messaging-rcs-contract-aidl",
        // JAIN-SIP for the in-app carrier SIP/MSRP transport; see docs/rcs/carrier-transport.md.
        "nist-sip",
        // The MLS engine; see docs/mls/overview.md.
        "messaging-mls-engine",
        // Carrier for the MLS retry queue; the schedule itself is MlsRetryPolicy in the engine.
        "androidx.work_work-runtime",
    ],

    aaptflags: [
        // No --version-name: aapt2 applies it only when the manifest has none, so it is set there.
        "--version-code",
        "10001680",
    ],
    required: [
        "libframesequence",
        "libgiftranscode2",
        "com.android.messaging.allowlist",
    ],
    optimize: {
        obfuscate: true,
        optimize: true,
        enabled: true,
    },

    // system_current: the SipDelegate path uses @SystemApi telephony-ims classes.
    sdk_version: "system_current",

    product_specific: true,
}

prebuilt_etc {
    name: "com.android.messaging.allowlist",
    product_specific: true,
    sub_dir: "sysconfig",
    src: "com.android.messaging.allowlist.xml",
}

// Host libraries and tests for the pure-Java carrier pieces; see docs/testing.md.

// The provider/app AIDL contract's ordinal-layout decision, JDK only.
java_library_host {
    name: "messaging-rcs-contract-layout-host",
    srcs: ["aidl/src/java/org/lineageos/rcs/provider/RcsContractLayout.java"],
}

java_test_host {
    name: "messaging-rcs-contract-host-tests",
    srcs: [
        "tests/src/org/lineageos/rcs/provider/**/*.java",
        // RcsIncomingFile's parcel order, round-tripped through host stand-ins for android.os.
        "aidl/src/java/org/lineageos/rcs/provider/RcsIncomingFile.java",
        "tests/hoststubs/android/os/Parcel.java",
        "tests/hoststubs/android/os/Parcelable.java",
        "tests/hoststubs/android/os/ParcelFileDescriptor.java",
        "tests/hoststubs/androidx/annotation/Nullable.java",
    ],
    static_libs: [
        "messaging-rcs-contract-layout-host",
        "junit-host",
    ],
    test_suites: ["general-tests"],
}

// Pure-Java MSRP framing (RFC 4975).
java_library_host {
    name: "messaging-rcs-msrp-host",
    srcs: ["src/com/android/messaging/rcs/carrier/msrp/*.java"],
}

// Android-free carrier glue.
java_library_host {
    name: "messaging-rcs-carrier-bridge-host",
    srcs: [
        "src/com/android/messaging/rcs/carrier/Message.java",
        "src/com/android/messaging/rcs/carrier/Transport.java",
        "src/com/android/messaging/rcs/carrier/RcsImsConfig.java",
        "src/com/android/messaging/rcs/carrier/CarrierSipRegistrarState.java",
        "src/com/android/messaging/rcs/carrier/CarrierTransportBridge.java",
    ],
}

// MSRP chat-session layer; the JAIN-SIP-coupled CarrierMsrpSessionManager stays on-device.
java_library_host {
    name: "messaging-rcs-msrp-session-host",
    srcs: [
        "src/com/android/messaging/rcs/carrier/msrp/session/SdpOffer.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/SdpAnswer.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/SdpParseException.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/MsrpSessionInfo.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/MsrpChatSession.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/MsrpTlsConnection.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/CarrierMsrpSessionSender.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/CarrierMsrpSessionReceiver.java",
    ],
    static_libs: [
        "messaging-rcs-msrp-host",
        "messaging-rcs-carrier-bridge-host",
    ],
}

// SIP, CPIM and IMDN wire shapes; the JAIN-SIP sender and receiver stay on-device.
java_library_host {
    name: "messaging-rcs-sip-host",
    srcs: [
        "src/com/android/messaging/rcs/carrier/sip/CpimMessage.java",
        "src/com/android/messaging/rcs/carrier/sip/CpimParseException.java",
        "src/com/android/messaging/rcs/carrier/sip/CpimDateTime.java",
        "src/com/android/messaging/rcs/carrier/sip/ImdnNotification.java",
        "src/com/android/messaging/rcs/carrier/sip/ImdnParseException.java",
        "src/com/android/messaging/rcs/carrier/sip/IsComposingNotification.java",
    ],
}

// The phone-number mask for log lines (plain JDK). Its own module so the MLS engine, which cannot
// see the app's classes, links the same class; the app compiles it from src/ like any other, and
// the static library's copy is dropped as a duplicate when the app's jar is merged.
java_library {
    name: "messaging-log-mask",
    srcs: ["src/com/android/messaging/rcs/log/LogMask.java"],
    sdk_version: "core_current",
    visibility: ["//packages/apps/Messaging"],
}

java_library_host {
    name: "messaging-log-mask-host",
    srcs: ["src/com/android/messaging/rcs/log/LogMask.java"],
}

// RFC 2617 MD5 SIP Digest helper (plain JDK).
java_library_host {
    name: "messaging-rcs-sip-digest-auth-host",
    srcs: ["src/com/android/messaging/rcs/carrier/SipDigestAuth.java"],
}

java_test_host {
    name: "messaging-rcs-carrier-host-tests",
    // Scoped to the carrier package: a tests/src/** glob would also pick up the MLS engine tests.
    srcs: [
        "tests/src/com/android/messaging/rcs/carrier/**/*.java",
        // For the source-scan halves of the carrier guards.
        "tests/src/com/android/messaging/rcs/SourceScan.java",
        // App-side and pure Java; used to build real framed payloads for the binary-safety test.
        "engine/src/com/android/messaging/rcs/engine/mls/RccMlsBody.java",
        // The registrar's bearer and P-CSCF decision; the SystemProperties read stays in
        // CarrierSipRegistrar.
        "src/com/android/messaging/rcs/carrier/CarrierSipPlane.java",
    ],
    static_libs: [
        // For RccContentDisposition: messaging-mls-engine is a device library.
        "messaging-mls-policy-host",
        "messaging-rcs-msrp-host",
        "messaging-rcs-msrp-session-host",
        "messaging-rcs-sip-host",
        "messaging-rcs-sip-digest-auth-host",
        "messaging-rcs-carrier-bridge-host",
        "messaging-log-mask-host",
        "junit-host",
    ],
    test_suites: ["general-tests"],
}

// The terminal-status decision for TRANSPORT_RCS rows, split out of its Android-coupled callers
// so it can be host-tested.
java_library_host {
    name: "messaging-rcs-send-status-host",
    srcs: ["src/com/android/messaging/rcs/RcsSendStatus.java"],
}

// Checks onCreate's fresh schema against the onUpgrade chain.
java_test_host {
    name: "messaging-db-schema-host-tests",
    srcs: [
        "tests/src/com/android/messaging/datamodel/DatabaseSchemaGuardTest.java",
        "tests/src/com/android/messaging/rcs/SourceScan.java",
    ],
    static_libs: ["junit-host"],
    test_suites: ["general-tests"],
}

java_test_host {
    name: "messaging-rcs-send-status-host-tests",
    srcs: [
        "tests/src/com/android/messaging/rcs/sendstatus/**/*.java",
        "tests/src/com/android/messaging/rcs/RcsContractKeepRuleGuardTest.java",
        "tests/src/com/android/messaging/rcs/SourceScan.java",
        // Module-wide: no source, test, doc or file name uses the retired test-network name.
        "tests/src/com/android/messaging/rcs/TestNetworkWordGuardTest.java",
        // The padlock decision and what it reads; host stand-ins for its two android calls.
        "src/com/android/messaging/rcs/RcsEarlyStatusPark.java",
        // The send path's wait for a settling RCS state.
        "src/com/android/messaging/rcs/RcsSendReadiness.java",
        // How a received file is stored and drawn; which displayed receipts a read sends.
        "src/com/android/messaging/rcs/RcsFileAttachment.java",
        "src/com/android/messaging/rcs/RcsDisplayedReceipts.java",
        "src/com/android/messaging/rcs/e2ee/E2eeObservation.java",
        "src/com/android/messaging/rcs/e2ee/E2eeSchemeGate.java",
        "src/com/android/messaging/rcs/e2ee/EncryptionProtocolBits.java",
        "src/com/android/messaging/rcs/e2ee/MlsCapabilities.java",
        // Whether an inbound MLS message is a redelivery of a stored one.
        "src/com/android/messaging/rcs/e2ee/MlsInboundRedelivery.java",
        "src/com/android/messaging/rcs/e2ee/RcsE2eeScheme.java",
        "tests/hoststubs/android/os/SystemProperties.java",
        "tests/hoststubs/android/text/TextUtils.java",
    ],
    static_libs: [
        "messaging-rcs-send-status-host",
        "junit-host",
    ],
    test_suites: ["general-tests"],
}

// The MLS engine; see docs/mls/overview.md. The package name fixes the JNI symbol names
// (Java_com_android_messaging_rcs_engine_mls_OpenMlsNative_*): renaming it means regenerating
// the bridge.
java_library {
    name: "messaging-mls-engine",
    srcs: ["engine/src/**/*.java"],
    static_libs: ["messaging-log-mask"],
    sdk_version: "system_current",
    // Transport-neutral MLS only, no BouncyCastle. Add a consumer to visibility rather than
    // forking the classes.
    visibility: [
        "//packages/apps/Messaging",
        // The self-test APK under selftest/.
        "//packages/apps/Messaging:__subpackages__",
    ],
}

// The pure-Java part of the engine, recompiled for the host tests; see docs/testing.md.
// MlsEngineHostClasspathGuardTest fails when an engine class is neither listed nor exempted.
