package {
    // See: http://go/android-license-faq
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

// 2-app split: simplified from LineageOS's
// soong_config eng/user proguard-variant dance (the keep_runtime_invisible_
// annotations field + nested conditions_default aren't valid in this AOSP
// Soong). Plain java_defaults with the release proguard flags. Revisit if the
// eng-variant test-proguard split is ever needed.
java_defaults {
    name: "messaging_defaults",
    optimize: {
        proguard_flags_files: [
            "proguard.flags",
            "proguard-release.flags",
        ],
    },
}


filegroup {
    name: "messaging-srcs",
    srcs: ["src/**/*.java"],
}


android_app {
    name: "messaging",

    // Platform-signed so it can hold the signature|privileged BIND_RCS_PROVIDER
    // permission used to bind an RCS provider app, and so the native-IMS path
    // can reach the telephony APIs it needs.
    certificate: "platform",

    // A filegroup rather than a glob so that anything else needing "the app's
    // sources" refers to the same list by construction.
    srcs: [":messaging-srcs"],

    jni_libs: ["libmlsopenmlsbridge"],
    use_embedded_native_libs: true,

    defaults: ["messaging_defaults"],

    static_libs: [
        "androidx.activity_activity",
        "androidx.annotation_annotation",
        "androidx.appcompat_appcompat",
        "androidx.collection_collection",
        "androidx.core_core",
        // Emoji-reactions: the AndroidX EmojiCompat validity trie. Used to gate
        // an arbitrary user-picked glyph (the picker "+" path) to a real emoji
        // BEFORE we send it as a reaction -- "any emoji" is a validity check, not
        // an allowlist (see design-emoji-reactions-2026-06-09.md).
        "androidx.emoji2_emoji2",
        "androidx.exifinterface_exifinterface",
        "androidx.fragment_fragment",
        "androidx.media_media",
        "androidx.palette_palette",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "androidx.viewpager_viewpager",
        "colorpicker",
        "com.android.vcard",
        "com.google.android.material_material",
        "guava",
        "libchips",
        "libphonenumber",
        "libphotoviewer",
        // The RCS provider contract (IRcsProvider + callback + parcelables),
        // consumed by the rcs/ client classes. See aidl/.
        "messaging-rcs-contract-aidl",
        "messaging-mls-engine",
        // JAIN-SIP reference implementation (javax.sip.* + gov.nist.*) for the
        // Dual-Registration (DR) carrier-RCS stack (design §6.3, D6): the app-owned
        // SIP-REGISTER-over-IMS-APN path in rcs/carrier/** (CarrierRcsTransport +
        // CarrierSipRegistrar + CarrierMessageSender + its own MSRP), driven by
        // CarrierStackDrModeDriver when the modem lacks the SipDelegate single-
        // registration API. The carrier + MSRP + CPIM/SIP + SDP source now lives in
        // this repo (com.android.messaging.rcs.carrier.**, compiled via the app
        // src glob); only the external JAIN-SIP library is pulled in here.
        "nist-sip",
        // BouncyCastle: MlsCredential mints RCC.16 certs via org.bouncycastle.{asn1,cert,operator}.*.
        "bouncycastle-unbundled",
        "bouncycastle-bcpkix-unbundled",
        // The MLS operation retry queue (rework 5.6). The SCHEDULE lives in the engine module
        // (MlsRetryPolicy, pure and host-tested) because its two verified negatives -- no dedup of
        // scheduled work, linear rather than exponential backoff -- are the parts that are easy to
        // get wrong and expensive to discover. This is only the carrier for it.
        "androidx.work_work-runtime",
    ],

    aaptflags: [
        // No --version-name here: aapt2 applies it only "if none is present" in
        // the manifest, so setting it in both places would be two sources for one
        // value with the loser silent.
        "--version-code",
        "10001680",
    ],
    required: [
        "libframesequence",
        "libgiftranscode2",
        "com.android.messaging.allowlist",
    ],
    optimize: {
        obfuscate: true,
        optimize: true,
        enabled: true,
    },

    // system_current (not plain current): the ride-Shannon SipDelegate path
    // (rcs/sip/) uses @SystemApi telephony-ims classes (SipDelegateManager,
    // SipDelegateConnection, DelegateRegistrationState, ProvisioningManager.
    // setRcsClientConfiguration, etc.) which are not in the public SDK. The app
    // is platform-signed + system SMS-role holder, so the system API surface is
    // the correct compile target.
    sdk_version: "system_current",

    product_specific: true,
}

prebuilt_etc {
    name: "com.android.messaging.allowlist",
    product_specific: true,
    sub_dir: "sysconfig",
    src: "com.android.messaging.allowlist.xml",
}

// ---------------------------------------------------------------------------
// Carrier-RCS (DR / SIP+MSRP) host-side unit-test libraries + test module.
// The carrier transport source lives in this repo under
// src/com/android/messaging/rcs/carrier/** (compiled into the app via the app
// src glob + nist-sip). These java_library_host modules additionally compile
// the pure-Java (Android-free, JAIN-SIP-free) subset for off-device unit tests.
// ---------------------------------------------------------------------------

// The provider/app AIDL contract's ordinal-layout decision. JDK-only on purpose: the
// part worth testing off-device is whether two recorded layouts may safely talk, and the fixtures
// that pin it are layouts recovered from real builds. The Android-coupled half
// (RcsContractProbe: reflection over the generated stub + the reserved binder transaction) stays
// on-device, because there is nothing to decide there that a host can observe.
java_library_host {
    name: "messaging-rcs-contract-layout-host",
    srcs: ["aidl/src/java/org/lineageos/rcs/provider/RcsContractLayout.java"],
}

// Host-side unit tests for that decision. Separate target rather than folded into the carrier or
// engine suites: this is the provider/app SEAM, which is neither.
java_test_host {
    name: "messaging-rcs-contract-host-tests",
    srcs: ["tests/src/org/lineageos/rcs/provider/**/*.java"],
    static_libs: [
        "messaging-rcs-contract-layout-host",
        "junit-host",
    ],
    test_suites: ["general-tests"],
}

// Pure-Java MSRP framing (RFC 4975).
java_library_host {
    name: "messaging-rcs-msrp-host",
    srcs: ["src/com/android/messaging/rcs/carrier/msrp/*.java"],
}

// Android-free carrier glue: the Transport interface + Message model +
// RcsImsConfig (JDK-only; JSON parsing lives in the sibling RcsImsConfigParser,
// which is NOT included here so the host classpath stays org.json-free) +
// the registrar state enum + the transport bridge.
java_library_host {
    name: "messaging-rcs-carrier-bridge-host",
    srcs: [
        "src/com/android/messaging/rcs/carrier/Message.java",
        "src/com/android/messaging/rcs/carrier/Transport.java",
        "src/com/android/messaging/rcs/carrier/RcsImsConfig.java",
        "src/com/android/messaging/rcs/carrier/CarrierSipRegistrarState.java",
        "src/com/android/messaging/rcs/carrier/CarrierTransportBridge.java",
    ],
}

// MSRP chat-session layer: SDP offer/answer, session state machine, session-info
// POJO, TLS connection wrapper, and the MSRP-SEND sender/receiver pair. The
// JAIN-SIP-coupled CarrierMsrpSessionManager is intentionally excluded (on-device).
java_library_host {
    name: "messaging-rcs-msrp-session-host",
    srcs: [
        "src/com/android/messaging/rcs/carrier/msrp/session/SdpOffer.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/SdpAnswer.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/SdpParseException.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/MsrpSessionInfo.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/MsrpChatSession.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/MsrpTlsConnection.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/CarrierMsrpSessionSender.java",
        "src/com/android/messaging/rcs/carrier/msrp/session/CarrierMsrpSessionReceiver.java",
    ],
    static_libs: [
        "messaging-rcs-msrp-host",
        "messaging-rcs-carrier-bridge-host",
    ],
}

// Pure-Java SIP/CPIM/IMDN wire-shape primitives (the JAIN-SIP-coupled
// CarrierMessageSender/Receiver are excluded).
java_library_host {
    name: "messaging-rcs-sip-host",
    srcs: [
        "src/com/android/messaging/rcs/carrier/sip/CpimMessage.java",
        "src/com/android/messaging/rcs/carrier/sip/CpimParseException.java",
        "src/com/android/messaging/rcs/carrier/sip/CpimDateTime.java",
        "src/com/android/messaging/rcs/carrier/sip/ImdnNotification.java",
        "src/com/android/messaging/rcs/carrier/sip/ImdnParseException.java",
        "src/com/android/messaging/rcs/carrier/sip/IsComposingNotification.java",
    ],
}

// RFC 2617 MD5 SIP Digest helper (plain JDK).
java_library_host {
    name: "messaging-rcs-sip-digest-auth-host",
    srcs: ["src/com/android/messaging/rcs/carrier/SipDigestAuth.java"],
}

// Host-side unit tests for the carrier-RCS pure-Java pieces (MSRP framing + SDP +
// session state machine + CPIM/IMDN + SIP Digest + the loopback SIP+MSRP harness).
java_test_host {
    name: "messaging-rcs-carrier-host-tests",
    // Scoped to the carrier package rather than all of tests/src: the MLS engine tests live
    // alongside these now and need a different static_lib, so a tests/src/** glob would swallow
    // them and fail to compile.
    srcs: [
        "tests/src/com/android/messaging/rcs/carrier/**/*.java",
        // Which bearer the SIP registrar targets, and who is authoritative about the P-CSCF.
        // Pure Java on purpose — the SystemProperties read lives at its one call site in
        // CarrierSipRegistrar, which is Android-coupled and untestable here, so that the DECISION
        // is host-testable even though the plumbing is not.
        "src/com/android/messaging/rcs/carrier/CarrierSipPlane.java",
    ],
    static_libs: [
        "messaging-rcs-msrp-host",
        "messaging-rcs-msrp-session-host",
        "messaging-rcs-sip-host",
        "messaging-rcs-sip-digest-auth-host",
        "messaging-rcs-carrier-bridge-host",
        "junit-host",
    ],
    test_suites: ["general-tests"],
}

// The RCS row's TERMINAL-STATUS decision: which message_status a send may leave a
// TRANSPORT_RCS row in, and which statuses nothing can ever move it out of. Pure Java, no Android,
// because every site that applies it (InsertNewMessageAction, FixupMessageStatusOnStartupAction,
// ResendMessageAction, ConversationMessageData) needs a database, a bound provider or a Context and
// therefore has no host test at all. Splitting the DECISION out is what makes the part worth
// testing testable; the guards in the test target below check that production still consults it.
java_library_host {
    name: "messaging-rcs-send-status-host",
    srcs: ["src/com/android/messaging/rcs/RcsSendStatus.java"],
}

// The two database code paths -- onCreate's fresh schema and onUpgrade's migration chain -- are
// written in different files and nothing connected them. This is the only thing that does.
java_test_host {
    name: "messaging-db-schema-host-tests",
    srcs: [
        "tests/src/com/android/messaging/datamodel/DatabaseSchemaGuardTest.java",
        "tests/src/com/android/messaging/rcs/SourceScan.java",
    ],
    static_libs: ["junit-host"],
    test_suites: ["general-tests"],
}

java_test_host {
    name: "messaging-rcs-send-status-host-tests",
    srcs: [
        "tests/src/com/android/messaging/rcs/sendstatus/**/*.java",
        // Asserts the R8 keep rule below names the package the contract is actually in. Listed
        // here rather than globbed because this package enumerates its host sources.
        "tests/src/com/android/messaging/rcs/RcsContractKeepRuleGuardTest.java",
        // The shared source-scanning helper, listed by path rather than copied. It is globbed into
        // messaging-mls-engine-host-tests as well; its own javadoc records that it now compiles
        // into two targets and which members are public for this one. A fourth hand-rolled copy of
        // read/codeOnly/bodyOf is exactly the drift that class was extracted to stop.
        "tests/src/com/android/messaging/rcs/SourceScan.java",
    ],
    static_libs: [
        "messaging-rcs-send-status-host",
        "junit-host",
    ],
    test_suites: ["general-tests"],
}

// ============================================================================
// THE NATIVE HALF OF THE MLS ENGINE. Its Java half lives in engine/.
// ============================================================================
// The pure-Rust MLS core (mls-rs), BUILT FROM SOURCE by Soong against the crates in
// external/mls-rs. libmlsopenmlsbridge = the JNI face (jni/mls_openmls_bridge.c) that
// whole-static-links it. Java face: OpenMlsNative -> OpenMlsEngine.
rust_ffi_static {
    name: "librcs_mls_ffi",
    crate_name: "rcs_mls_ffi",
    srcs: ["rust/rcs_mls_ffi/src/lib.rs"],
    edition: "2021",
    enabled: false,
    arch: { arm64: { enabled: true } },
    compile_multilib: "first",
    // The relaxed lint set, not the platform default. This crate was built out-of-tree by cargo
    // until it moved into the build, so it has never been written to AOSP's Rust style: the
    // platform set adds -D missing-docs (about 150 findings across a 7,200-line FFI surface) and
    // -D unsafe_op_in_unsafe_fn (about 175, each needing an unsafe block inside an already-unsafe
    // fn). "vendor" still runs clippy and still denies warnings, so the build is gated, not waved
    // through -- the 20 findings it did report were fixed rather than suppressed.
    lints: "vendor",
    clippy_lints: "vendor",
    rustlibs: [
        "libmls_rs_fork",
        "libmls_rs_core_mls_rs",
        "libmls_rs_crypto_rustcrypto",
        "libmls_rs_identity_x509",
        "libzeroize_mls_rs",
        "libgetrandom_mls_rs",
        "libder_mls_rs",
        "libx509_cert_mls_rs",
        "libsha2",
        "libp256",
    ],
    system_ext_specific: true,
    // Package-agnostic Rust MLS staticlib with a plain C ABI, so more than one JNI
    // bridge can link it. An out-of-tree provider that needs it should be added here.
    visibility: ["//packages/apps/Messaging"],
}

cc_library_shared {
    name: "libmlsopenmlsbridge",
    srcs: ["jni/mls_openmls_bridge.c"],
    header_libs: ["jni_headers"],
    whole_static_libs: ["librcs_mls_ffi"],
    shared_libs: ["liblog"],
    compile_multilib: "64",
    enabled: false,
    arch: { arm64: { enabled: true } },
    system_ext_specific: true,
    // One bridge and one engine java_library means one set of JNI symbols and no drift.
    visibility: ["//packages/apps/Messaging"],
}

// ============================================================================
// THE MLS ENGINE.
//
// The Java half of the MLS implementation, kept in its own library because a
// provider app links the same classes and the same JNI bridge.
//
// The package name com.android.messaging.rcs.engine.mls is LOAD-BEARING: the
// JNI symbols exported by libmlsopenmlsbridge are derived from it
// (Java_com_android_messaging_rcs_engine_mls_OpenMlsNative_*). Renaming the
// package means regenerating the C bridge symbols in lockstep — never do one
// without the other.
// ============================================================================
java_library {
    name: "messaging-mls-engine",
    srcs: ["engine/src/**/*.java"],
    sdk_version: "system_current",
    // Transport-neutral MLS crypto only (MlsEngine/OpenMls*/MlsIdentity/MlsGroupArtifacts).
    // The carrier/lab glue that needs BouncyCastle (MlsCredential/RcsKdsClient/MlsTrustAnchors)
    // lives in com.android.messaging.rcs.e2ee, NOT here — so no BC dep.
    //
    // There is ONE copy of these classes. An out-of-tree RCS provider that needs to
    // link them should be added to visibility here rather than forking them: two
    // implementations of one protocol contract drift, and the drift is silent.
    visibility: ["//packages/apps/Messaging"],
}

// MLS recovery DECISIONS + the RCC.16 spec crypto (gate deadline, era tie-break + bounded yield,
// resync-failure action; commitments, VerifiableDerivedContent, Annex C.2/C.3 file encryption).
// PURE JAVA, no Android and no engine deps, so the host tests exercise the SAME code production
// calls. These rules only fire in failures the fleet cannot produce on demand, and the spec crypto
// cannot be verified against a peer we are unable to ask — unit tests are the only honest coverage.
java_library_host {
    name: "messaging-mls-policy-host",
    srcs: [
        // In the SHARED engine module so the app that owns MLS and the provider that
        // carries it run ONE copy of these decisions — the counter/AAD drift the migration exists to
        // end was exactly two copies of one contract.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsRecoveryPolicy.java",
        // WHO advances an era and WHEN a non-advancer may stop waiting for one that is never coming
        // for. Split out of MlsRecoveryPolicy rather than added to it because it
        // answers a question that class deliberately does not: weAreEraAdvancer is a pure function of
        // two numbers, while this one weighs LIVENESS EVIDENCE, and mixing the two would put a local,
        // asymmetric input into the decision every member must derive identically.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsAdvancerElection.java",
        // What ONE PASS of the self-heal ladder costs, and how many looks it records.
        // Host-listed because it is the class that stops MlsAdvancerElection.takeoverReachableWithin
        // being decorative: its enclosingSelfHealAttempts COMPUTES that predicate's argument from
        // the charge a look makes, so the assertion is about production rather than about a literal
        // somebody typed into a test. It also holds the ONE look-accounting arithmetic both yield
        // paths run, which used to be reconciled by a comment saying "do NOT record the look here".
        "engine/src/com/android/messaging/rcs/engine/mls/MlsSelfHealPass.java",
        // The PROACTIVE half, kept separate from MlsRecoveryPolicy on purpose: Google Messages'
        // membership-delta gate applies ONLY to the maintenance refresh, and recovery is structurally
        // exempt. Two classes make it hard to consult the wrong one by accident.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsMaintenancePolicy.java",
        // The UPGRADE guard set — Google Messages' own preconditions, all ELEVEN of which are
        // silent skips there. Separate from the two policies above because it answers a different
        // question: not "should we refresh" or "should we recover", but "may this conversation
        // become MLS at all".
        "engine/src/com/android/messaging/rcs/engine/mls/MlsUpgradePolicy.java",
        // The KeyPackages ONE upgrade claimed, carried from the count to the create.
        // Host-listed because it is what stops the count and the create being two spends: the type
        // is the difference between "a counter that consumes what it counts" and a claim that is
        // made once and used. Its three states — refused / claimed-but-empty / not-covered — must
        // stay distinguishable, and that is a property a host test can hold still.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsUpgradeClaim.java",
        // Whether a re-establish is a FIRST create or a RE-creation every member must re-join by
        // Welcome. Separate from MlsRecoveryPolicy because it decides what an operation
        // COSTS A PEER rather than whether to attempt it, and because the obvious predicate — "is a
        // GroupInfo carry present" — is wrong for the two shapes that matter (a 1:1 rebuild and a
        // REJOIN both re-create with no carry). Host-tested so that stays written down.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsReestablishPolicy.java",
        // The question AFTER the line above: a charge is already spent in this recovery
        // episode — does THIS door need its own? Separate because the first is a measurement about
        // the server and this is bookkeeping about what we did a hundred milliseconds ago, and
        // conflating them is how one re-creation gets billed twice by two methods that each believe
        // they are the only one counting. Event E1 had four doors, three reconciled by a boolean, a
        // local and an ordering comment, and one — eraAdvance -> the INCORRECT_ERA rebuild — by
        // nothing.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsRecreationEpisode.java",
        // Why G2 may be charged ABOVE the era-advance mode branch. The preserving modes
        // send welcome=new byte[0] and re-Welcome nobody as source shape, which reads as an
        // over-charge — but §9.2 makes them illegal and the engine refuses to BUILD them, so they
        // take BUILD_FAILED into the legacy create in the same call. The funnel charge is EXACT,
        // and this is where that stops being an emergent property of a branch 100 lines below it.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsEraAdvanceCharge.java",
        // WHICH of G1/G2/G4/G6 an MLS state change must pass, and in what order. The arithmetic
        // was already here — MlsEraBudgetRecord, MlsPeerHealthRecord — but the COMPOSITION was four
        // MlsPeerGuard methods calling each other, so "which budgets apply to this operation" was
        // not a value anywhere and nothing could assert it. Three separate changes each got exactly
        // one row of that table wrong and not one of the three was a wrong answer from a budget.
        // MlsPeerGuard keeps the store, the sysprops, the
        // redaction and the refusal lines; it needs a Context and stays off this classpath.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsStateChangeGate.java",
        // WHEN our PUBLISHED KeyPackage pool is refreshed — the periodic tick, the drain signal and
        // the unopenable-Welcome repair, which are three different questions the transport's own
        // comment had confused with each other twice. Host-listed
        // because the estimate these bounds run on is structurally an UPPER BOUND, never a count,
        // and the device measurement that proved it — three devices believing they had 7, 7 and 9
        // while two pools were empty — is not one anybody wants to repeat to check an interval.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsKeyPackagePolicy.java",
        // Participant-key derivation for the lab (open5gs) IMS setup. Host-listed because
        // the point of the class is that two processes reach the SAME bytes, which a host
        // test can assert directly (byte-identical SPKI/PKCS#8) and a device cannot check at
        // all — a mismatch there surfaces as an opaque refusal that names neither side.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsParticipantKeyDerivation.java",
        // WHEN our own leaf key rotates, how the two sides are STAGGERED so they do not duel over
        // it, and where the counter lands when a rotation is refused. Host-listed because the
        // stagger is the fix for a device-observed wedge — era 13 -> 17
        // in one bidirectional run — and the fix is arithmetic over two numbers, which is the one
        // shape that can be asserted without a second device. It is deliberately NOT a knob: the
        // sysprop that would arm it is off-limits as a commit trigger.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsRekeyPolicy.java",
        // The application-message wire details both owners must agree on byte-for-byte.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsAppMessage.java",
        "engine/src/com/android/messaging/rcs/engine/mls/MlsResentMessage.java",
        // The §11.3a receiver ORDERING. Separate from MlsResentMessage because it
        // answers a different question — that class holds the wire details, this one holds the
        // order the checks run in and what each outcome is allowed to do. The order is the
        // correctness property, it lived in MlsProviderTransport where no host test could reach
        // it, and it did not survive there: a guard twenty lines above the selector made the
        // selector unreachable and routed every group resend into §10 recovery.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsResendReceive.java",
        // What a REFUSAL is allowed to do. Same reason as the line above and the same
        // defect one level over: two arms whose comments said the message DECRYPTED both returned
        // null, which the router reads as "did not decrypt" — so a detected impersonation triggered
        // a self-heal, a FALSE §7.7.2.2 report, and after three of them a conversation rebuild. The
        // three predicates are false for every reason and a host test walks the enum, so a refusal
        // added later cannot inherit wire effects by omission.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsInboundRefusal.java",
        // The off-thread seam. Pure Java by design: it was a private nested interface
        // in MlsProviderTransport, where no host test could reach it because that class needs a
        // Context and a bound provider. Here it is testable on its own terms.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsOffThread.java",
        // Per-member group delivery coverage — pure Java so the coverage rule is
        // host-tested rather than verified by reading logcat on three devices.
        "engine/src/com/android/messaging/rcs/engine/mls/MlsGroupDeliveryLedger.java",
        // The CPIM reaction envelope — pure string/byte parsing, host-tested against a
        // real captured Google Messages reaction.
        "engine/src/com/android/messaging/rcs/engine/mls/RccCpimReaction.java",
        // RCC.16 Annex C.1 commitments (icon/subject) — pure spec crypto, host-testable.
